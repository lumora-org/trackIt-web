# TrackIt — frontend environment
#
# Copy to `.env.local` and adjust. Only NEXT_PUBLIC_* values reach the browser,
# so never place a secret here (PROMPT.md §27).

# ---------------------------------------------------------------------------
# Mock API (default: on)
# ---------------------------------------------------------------------------
# While the mock is enabled the API base URL is empty on purpose: the MSW worker
# serves /api/v1/* from the page's own origin.
# Set to 'false' as soon as the real backend is available.
NEXT_PUBLIC_USE_MOCK_API=true

# ---------------------------------------------------------------------------
# Real backend — proxy transport (recommended, the default when mock is off)
# ---------------------------------------------------------------------------
# Leave NEXT_PUBLIC_API_BASE_URL unset: the browser calls its own origin and a
# Next.js rewrite (next.config.ts) forwards /api/v1/* to this server-side
# target. No CORS, and the httpOnly refresh cookie stays same-origin. When the
# projects are hosted, change only this value (it is read on the server, never
# shipped to the browser):
API_PROXY_TARGET=http://localhost:4000

# ---------------------------------------------------------------------------
# Real backend — direct transport (optional alternative)
# ---------------------------------------------------------------------------
# Uncomment to make the browser call the API origin directly. The backend must
# then allow the web origin in its CORS_ORIGIN, and when web and API live on
# different sites the backend also needs REFRESH_COOKIE_SAMESITE=none (plus a
# HTTPS secure cookie) so the refresh cookie round-trips.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
